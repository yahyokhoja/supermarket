{
  "name": "universal-supermarket-delivery",
  "version": "2.0.0",
  "description": "Universal supermarket delivery platform with TypeScript backend and React TSX frontend",
  "private": true,
  "scripts": {
    "start:all": "bash scripts/stack.sh start",
    "stop:all": "bash scripts/stack.sh stop",
    "restart:all": "bash scripts/stack.sh restart",
    "status:all": "bash scripts/stack.sh status",
    "doctor:all": "bash scripts/doctor.sh",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:baseline": "tsx scripts/bootstrap-baseline.ts",
    "network:select-owner": "tsx scripts/select-owner.ts",
    "test:db:up": "COMPOSE_PROJECT_NAME=supermarket-stage1-test bash scripts/compose-run.sh docker-compose.test.yml up -d",
    "test:db:down": "COMPOSE_PROJECT_NAME=supermarket-stage1-test bash scripts/compose-run.sh docker-compose.test.yml down",
    "migrate:merchant-products": "tsx scripts/migrate-merchant-products.ts",
    "dev:all": "bash scripts/stack.sh start",
    "dev:all:https": "npm run dev:https",
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:https": "concurrently -k \"npm:dev:api\" \"HTTPS=true npm run dev:web\"",
    "dev:api": "tsx src/server.ts",
    "dev:web": "vite --config frontend/vite.config.ts",
    "dev:web:https": "vite --config frontend/vite.config.ts --https",
    "https:cert": "bash scripts/gen-dev-cert.sh",
    "db:up": "bash scripts/compose-run.sh docker-compose.postgres.yml up -d",
    "db:down": "bash scripts/compose-run.sh docker-compose.postgres.yml down",
    "db:logs": "bash scripts/compose-run.sh docker-compose.postgres.yml logs -f postgres",
    "map:up": "bash scripts/compose-run.sh map-platform/docker-compose.yml up -d",
    "map:down": "bash scripts/compose-run.sh map-platform/docker-compose.yml down",
    "map:logs": "bash scripts/compose-run.sh map-platform/docker-compose.yml logs -f",
    "build:api": "tsc -p tsconfig.json",
    "build:web": "vite build --config frontend/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p frontend/tsconfig.json --noEmit",
    "lint": "npm run typecheck",
    "test": "npm run typecheck",
    "test:integration": "tsx --test --test-concurrency=1 tests/inventory.integration.test.ts",
    "vercel-build": "npm run build:web",
    "build": "npm run build:web && npm run build:api",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/leaflet": "^1.9.21",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
